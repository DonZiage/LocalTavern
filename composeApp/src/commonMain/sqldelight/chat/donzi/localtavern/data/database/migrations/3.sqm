-- v3 -> v4: SyncPeer trust store finalized. The duplicate xPublicKey column
-- (a leftover from an earlier design where the static identity key was not an
-- X25519 key) is dropped. The table is rebuilt defensively so the migration
-- works both on v2 databases that gained SyncPeer via migration 2.sqm and on
-- intermediate dev v3 databases that already carry the extra column; the
-- paired-device data survives in both cases.
ALTER TABLE SyncPeer RENAME TO SyncPeer_v3;
CREATE TABLE SyncPeer (
    deviceId TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    publicKey BLOB,
    lastKnownAddress TEXT,
    receivedCursor INTEGER NOT NULL DEFAULT 0,
    peerReceivedCursor INTEGER NOT NULL DEFAULT 0,
    lastSyncAt INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0
);
INSERT INTO SyncPeer(deviceId, name, publicKey, lastKnownAddress, receivedCursor, peerReceivedCursor, lastSyncAt, updatedAt, isDeleted)
SELECT deviceId, name, publicKey, lastKnownAddress, receivedCursor, peerReceivedCursor, lastSyncAt, updatedAt, isDeleted FROM SyncPeer_v3;
DROP TABLE SyncPeer_v3;
