CREATE TABLE CharacterEntity (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    personality TEXT,
    scenario TEXT,
    firstMes TEXT,
    mesExample TEXT,
    creatorNotes TEXT,
    altGreetings TEXT,
    avatarData BLOB,
    isAssistant INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    systemPrompt TEXT,
    postHistoryInstructions TEXT,
    creator TEXT,
    characterVersion TEXT,
    tags TEXT,
    extensions TEXT,
    characterBook TEXT,
    syncSeq INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_character_assistant ON CharacterEntity(isAssistant);

CREATE TABLE PersonaEntity (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    avatarData BLOB,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    syncSeq INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE ChatSession (
    id TEXT PRIMARY KEY NOT NULL,
    characterId TEXT NOT NULL,
    personaId TEXT NOT NULL,
    title TEXT,
    lastTimestamp INTEGER NOT NULL,
    currentMessageId TEXT,
    parentSessionId TEXT,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    syncSeq INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_session_character_time ON ChatSession(characterId, lastTimestamp DESC);

CREATE TABLE MessageEntity (
    id TEXT PRIMARY KEY NOT NULL,
    sessionId TEXT NOT NULL,
    role TEXT NOT NULL,
    content TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    parentId TEXT,
    isActivePath INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    imageData BLOB,
    imageRefs TEXT,
    reasoningText TEXT,
    costEstimate REAL,
    syncSeq INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_message_active_timeline ON MessageEntity(sessionId, isActivePath, timestamp ASC);
CREATE INDEX IF NOT EXISTS idx_message_siblings ON MessageEntity(sessionId, parentId, timestamp ASC);

CREATE TABLE ApiConnection (
    id TEXT PRIMARY KEY NOT NULL,
    provider TEXT NOT NULL,
    name TEXT NOT NULL,
    baseUrl TEXT,
    apiKey TEXT,
    model TEXT,
    -- OpenRouter-style routing: which upstream provider should serve the
    -- model. Null means the endpoint's default provider is used.
    inferenceProvider TEXT,
    -- OpenRouter quantization preference (int4, int8, fp8, fp16, bf16).
    -- Null means the endpoint's default quantization.
    quantization TEXT,
    isActive INTEGER NOT NULL DEFAULT 0,
    isChatCompletion INTEGER NOT NULL DEFAULT 1,
    lastUsed INTEGER DEFAULT 0,
    temperature REAL NOT NULL DEFAULT 1.0,
    topP REAL NOT NULL DEFAULT 1.0,
    topK INTEGER NOT NULL DEFAULT 0,
    presencePenalty REAL NOT NULL DEFAULT 0.0,
    frequencyPenalty REAL NOT NULL DEFAULT 0.0,
    contextLimit INTEGER NOT NULL DEFAULT 4096,
    responseLimit INTEGER NOT NULL DEFAULT 0,
    displayOrder INTEGER NOT NULL DEFAULT 0,
    timeoutLimit INTEGER NOT NULL DEFAULT 60,
    reasoningOverride INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    syncSeq INTEGER NOT NULL DEFAULT 0
);

-- User overrides for the bundled pricing catalog. A row whose modelPattern
-- matches a model name wins over the built-in price for that provider/model.
CREATE TABLE ModelPricing (
    provider TEXT NOT NULL,
    modelPattern TEXT NOT NULL,
    inputPerMillion REAL NOT NULL,
    outputPerMillion REAL NOT NULL,
    currency TEXT NOT NULL DEFAULT 'USD',
    PRIMARY KEY (provider, modelPattern)
);

-- Trusted sync peers (device-to-device pairing). Keys and identity are
-- managed by the sync layer; the table is the durable trust store. The
-- X25519 public key is the pairing identity and the sync authentication
-- factor (per-exchange ephemeral keys provide the secrecy).
CREATE TABLE SyncPeer (
    deviceId TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    publicKey BLOB,
    lastKnownAddress TEXT,
    receivedCursor INTEGER NOT NULL DEFAULT 0,
    peerReceivedCursor INTEGER NOT NULL DEFAULT 0,
    lastSyncAt INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE AppSettings (
    id INTEGER PRIMARY KEY CHECK (id = 1) DEFAULT 1,
    isDarkMode INTEGER NOT NULL DEFAULT 1,
    activePersonaId TEXT,
    -- High-water mark of the hybrid logical clock (HLC) that stamps
    -- updatedAt on every synced row: max(wallClock, lastHlc + 1), advanced
    -- by every local write and by every timestamp received from a peer.
    -- Persisting it makes clock-skew-resilient LWW survive app restarts.
    lastHlc INTEGER NOT NULL DEFAULT 0,
    -- Per-device preferences (never synced). sendWithCtrlEnter: Enter inserts
    -- a newline and Ctrl+Enter sends; when off (default) Enter sends.
    sendWithCtrlEnter INTEGER NOT NULL DEFAULT 0,
    -- Auto-sync with paired devices when the app starts.
    autoSyncOnLaunch INTEGER NOT NULL DEFAULT 0,
    -- Ask for confirmation before deleting characters/personas.
    confirmBeforeDelete INTEGER NOT NULL DEFAULT 1,
    -- High-water mark of the per-row sync sequence counter (the syncSeq
    -- column on every synced table). Unlike the HLC timestamp, syncSeq is a
    -- strictly monotone DEVICE-LOCAL counter: every local write and every
    -- incoming row that is applied is stamped with a fresh value, so a row
    -- can never carry a sequence below a cursor that was already advanced
    -- past it (a row "arriving late" from a lagging peer always gets a
    -- sequence newer than every previously delivered row). Cursors are exact
    -- with no boundary/equality cases.
    lastSyncSeq INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE PromptBlockEntity (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    template TEXT NOT NULL,
    isEnabled INTEGER NOT NULL DEFAULT 1,
    isCustom INTEGER NOT NULL DEFAULT 0,
    displayOrder INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    syncSeq INTEGER NOT NULL DEFAULT 0
);

-- ==========================================
-- Standard Queries (Filtered for Non-Deleted)
-- ==========================================

selectAllCharacters:
SELECT * FROM CharacterEntity WHERE isDeleted = 0 ORDER BY isAssistant DESC, name ASC;

selectAssistant:
SELECT * FROM CharacterEntity WHERE isAssistant = 1 AND isDeleted = 0 LIMIT 1;

selectAllPersonas:
SELECT * FROM PersonaEntity WHERE isDeleted = 0 ORDER BY name ASC;

selectSessionById:
SELECT * FROM ChatSession WHERE id = ? AND isDeleted = 0;

selectLastSessionForCharacterAndPersona:
SELECT * FROM ChatSession WHERE characterId = ? AND personaId = ? AND isDeleted = 0 ORDER BY lastTimestamp DESC LIMIT 1;

selectSessionsForCharacter:
SELECT * FROM ChatSession WHERE characterId = ? AND isDeleted = 0 ORDER BY lastTimestamp DESC;

selectSessionsForPersona:
SELECT * FROM ChatSession WHERE personaId = ? AND isDeleted = 0 ORDER BY lastTimestamp DESC;

selectActiveTimeline:
SELECT * FROM MessageEntity WHERE isDeleted = 0 AND sessionId = ? AND isActivePath = 1 ORDER BY timestamp ASC, rowid ASC;

selectSiblings:
SELECT * FROM MessageEntity WHERE isDeleted = 0 AND sessionId = ? AND parentId IS ? AND isActivePath = 1 ORDER BY timestamp ASC, rowid ASC;

selectAllApiConnections:
SELECT * FROM ApiConnection WHERE isDeleted = 0 ORDER BY displayOrder ASC;

selectActiveApiConnection:
SELECT * FROM ApiConnection WHERE isActive = 1 AND isDeleted = 0 LIMIT 1;

selectApiConnectionById:
SELECT * FROM ApiConnection WHERE id = ? AND isDeleted = 0 LIMIT 1;

getAppSettings:
SELECT * FROM AppSettings WHERE id = 1;

selectAllPromptBlocks:
SELECT * FROM PromptBlockEntity WHERE isDeleted = 0 ORDER BY displayOrder ASC;

insertCharacter:
INSERT INTO CharacterEntity(id, name, description, personality, scenario, firstMes, mesExample, creatorNotes, altGreetings, avatarData, isAssistant, updatedAt, isDeleted, systemPrompt, postHistoryInstructions, creator, characterVersion, tags, extensions, characterBook, syncSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCharacter:
UPDATE CharacterEntity
SET name = ?,
    description = ?,
    personality = ?,
    scenario = ?,
    firstMes = ?,
    mesExample = ?,
    altGreetings = ?,
    avatarData = ?,
    systemPrompt = ?,
    postHistoryInstructions = ?,
    creator = ?,
    characterVersion = ?,
    tags = ?,
    extensions = ?,
    characterBook = ?,
    updatedAt = ?,
    syncSeq = ?
WHERE id = ?;

deleteCharactersByIds:
UPDATE CharacterEntity SET isDeleted = 1, updatedAt = ?, syncSeq = ? WHERE id IN ?;

insertPersona:
INSERT INTO PersonaEntity(id, name, description, avatarData, updatedAt, isDeleted, syncSeq) VALUES (?, ?, ?, ?, ?, ?, ?);

updatePersona:
UPDATE PersonaEntity
SET name = ?,
    description = ?,
    avatarData = ?,
    updatedAt = ?,
    syncSeq = ?
WHERE id = ?;

deletePersona:
UPDATE PersonaEntity SET isDeleted = 1, updatedAt = ?, syncSeq = ? WHERE id = ?;

insertChatSession:
INSERT INTO ChatSession(id, characterId, personaId, title, lastTimestamp, currentMessageId, parentSessionId, updatedAt, isDeleted, syncSeq) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSessionCurrentMessage:
UPDATE ChatSession SET currentMessageId = ?, lastTimestamp = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

updateSessionTitle:
UPDATE ChatSession SET title = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

deleteSession:
UPDATE ChatSession SET isDeleted = 1, updatedAt = ?, syncSeq = ? WHERE id = ?;

insertMessageWithParent:
INSERT INTO MessageEntity(id, sessionId, role, content, timestamp, parentId, isActivePath, updatedAt, isDeleted, imageRefs, reasoningText, costEstimate, syncSeq) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deactivateSiblings:
UPDATE MessageEntity SET isActivePath = 0, updatedAt = ?, syncSeq = ? WHERE sessionId = ? AND parentId IS ? AND id != ?;

deactivateMessage:
UPDATE MessageEntity SET isActivePath = 0, updatedAt = ?, syncSeq = ? WHERE sessionId = ? AND id = ?;

activateMessage:
UPDATE MessageEntity SET isActivePath = 1, updatedAt = ?, syncSeq = ? WHERE id = ?;

selectAllMessagesForSession:
SELECT * FROM MessageEntity WHERE sessionId = ? AND isDeleted = 0;

selectAnyMessageForSession:
SELECT COUNT(*) FROM MessageEntity WHERE sessionId = ?;

updateMessageContent:
UPDATE MessageEntity SET content = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

updateMessageReasoning:
UPDATE MessageEntity SET reasoningText = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

updateMessageCostEstimate:
UPDATE MessageEntity SET costEstimate = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

updateMessageContentAndReasoning:
UPDATE MessageEntity SET content = ?, reasoningText = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

updateMessageImageRefs:
UPDATE MessageEntity SET imageRefs = ?, imageData = NULL, updatedAt = ?, syncSeq = ? WHERE id = ?;

deleteMessage:
UPDATE MessageEntity SET isDeleted = 1, updatedAt = ?, syncSeq = ? WHERE id = ?;

deleteMessagesForSession:
UPDATE MessageEntity SET isDeleted = 1, updatedAt = ?, syncSeq = ? WHERE sessionId = ?;

insertApiConnection:
INSERT INTO ApiConnection(
    id, provider, name, baseUrl, apiKey, model, inferenceProvider, quantization, isActive, isChatCompletion, lastUsed,
    temperature, topP, topK, presencePenalty, frequencyPenalty, contextLimit, responseLimit, displayOrder, timeoutLimit, reasoningOverride, updatedAt, isDeleted, syncSeq
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateApiConnection:
UPDATE ApiConnection
SET provider = ?,
    name = ?,
    baseUrl = ?,
    apiKey = ?,
    model = ?,
    inferenceProvider = ?,
    quantization = ?,
    isActive = ?,
    isChatCompletion = ?,
    temperature = ?,
    topP = ?,
    topK = ?,
    presencePenalty = ?,
    frequencyPenalty = ?,
    contextLimit = ?,
    responseLimit = ?,
    displayOrder = ?,
    timeoutLimit = ?,
    reasoningOverride = ?,
    updatedAt = ?,
    syncSeq = ?
WHERE id = ?;

updateApiConnectionLastUsed:
UPDATE ApiConnection SET lastUsed = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

updateApiConnectionApiKey:
UPDATE ApiConnection SET apiKey = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

deleteApiConnection:
UPDATE ApiConnection SET isDeleted = 1, updatedAt = ?, syncSeq = ? WHERE id = ?;

setActiveApiConnection:
UPDATE ApiConnection SET isActive = 0, updatedAt = ?, syncSeq = ? WHERE isActive = 1;

updateActiveApiConnection:
UPDATE ApiConnection SET isActive = 1, lastUsed = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

updateApiConnectionDisplayOrder:
UPDATE ApiConnection SET displayOrder = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

updateDarkMode:
UPDATE AppSettings SET isDarkMode = ? WHERE id = 1;

updateActivePersonaId:
UPDATE AppSettings SET activePersonaId = ? WHERE id = 1;

updateSendWithCtrlEnter:
UPDATE AppSettings SET sendWithCtrlEnter = ? WHERE id = 1;

updateAutoSyncOnLaunch:
UPDATE AppSettings SET autoSyncOnLaunch = ? WHERE id = 1;

updateConfirmBeforeDelete:
UPDATE AppSettings SET confirmBeforeDelete = ? WHERE id = 1;

insertDefaultSettings:
INSERT OR IGNORE INTO AppSettings(id, isDarkMode, activePersonaId) VALUES (1, 1, NULL);

-- ==========================================
-- Hybrid Logical Clock (updatedAt stamps)
-- ==========================================

selectLastHlc:
SELECT lastHlc FROM AppSettings WHERE id = 1;

updateLastHlc:
UPDATE AppSettings SET lastHlc = ? WHERE id = 1;

-- ==========================================
-- Sync sequence counter (syncSeq stamps)
-- ==========================================

selectLastSyncSeq:
SELECT lastSyncSeq FROM AppSettings WHERE id = 1;

updateLastSyncSeq:
UPDATE AppSettings SET lastSyncSeq = ? WHERE id = 1;

insertPromptBlock:
INSERT INTO PromptBlockEntity(id, name, template, isEnabled, isCustom, displayOrder, updatedAt, isDeleted, syncSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updatePromptBlock:
UPDATE PromptBlockEntity
SET name = ?,
    template = ?,
    isEnabled = ?,
    updatedAt = ?,
    syncSeq = ?
WHERE id = ?;

deletePromptBlock:
UPDATE PromptBlockEntity SET isDeleted = 1, updatedAt = ?, syncSeq = ? WHERE id = ? AND isCustom = 1;

updatePromptBlockDisplayOrder:
UPDATE PromptBlockEntity SET displayOrder = ?, updatedAt = ?, syncSeq = ? WHERE id = ?;

selectCharacterById:
SELECT * FROM CharacterEntity WHERE id = ? AND isDeleted = 0 LIMIT 1;

selectMessageById:
SELECT * FROM MessageEntity WHERE id = ? AND isDeleted = 0;

-- Blob-store migration: rows still carrying legacy inline images. The
-- extraction pass reads these, writes the blobs content-addressed and
-- replaces imageData with imageRefs; the query is naturally idempotent.
selectMessagesWithImages:
SELECT * FROM MessageEntity WHERE imageData IS NOT NULL;

-- GC key collection: every blob key referenced by a LIVE (non-tombstoned)
-- message. Files whose key is absent here are unreferenced and deletable.
selectAllLiveImageRefs:
SELECT imageRefs FROM MessageEntity WHERE imageRefs IS NOT NULL AND isDeleted = 0;

-- ==========================================
-- Model Pricing
-- ==========================================

selectAllModelPricing:
SELECT * FROM ModelPricing ORDER BY provider ASC, modelPattern ASC;

selectModelPricing:
SELECT * FROM ModelPricing WHERE provider = ? AND modelPattern = ?;

insertModelPricing:
INSERT OR REPLACE INTO ModelPricing(provider, modelPattern, inputPerMillion, outputPerMillion, currency)
VALUES (?, ?, ?, ?, ?);

updateModelPricing:
UPDATE ModelPricing
SET inputPerMillion = ?,
    outputPerMillion = ?,
    currency = ?
WHERE provider = ? AND modelPattern = ?;

deleteModelPricing:
DELETE FROM ModelPricing WHERE provider = ? AND modelPattern = ?;

-- ==========================================
-- Sync Peers
-- ==========================================

selectAllSyncPeers:
SELECT * FROM SyncPeer WHERE isDeleted = 0 ORDER BY name ASC;

selectSyncPeer:
SELECT * FROM SyncPeer WHERE deviceId = ? AND isDeleted = 0 LIMIT 1;

selectSyncPeerAny:
SELECT * FROM SyncPeer WHERE deviceId = ? LIMIT 1;

insertSyncPeer:
INSERT INTO SyncPeer(deviceId, name, publicKey, lastKnownAddress, receivedCursor, peerReceivedCursor, lastSyncAt, updatedAt, isDeleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Re-pairing a peer that was previously removed must revive the trust row:
-- isDeleted is reset so app-facing queries see it again.
updateSyncPeer:
UPDATE SyncPeer
SET name = ?,
    publicKey = ?,
    lastKnownAddress = ?,
    receivedCursor = ?,
    peerReceivedCursor = ?,
    lastSyncAt = ?,
    updatedAt = ?,
    isDeleted = 0
WHERE deviceId = ?;

updateSyncPeerCursors:
UPDATE SyncPeer SET receivedCursor = ?, peerReceivedCursor = ?, lastSyncAt = ?, updatedAt = ? WHERE deviceId = ?;

updateSyncPeerAddress:
UPDATE SyncPeer SET lastKnownAddress = ?, updatedAt = ? WHERE deviceId = ?;

-- Display-name updates arrive only through authenticated sync exchanges;
-- they never affect cursors or deltas.
updateSyncPeerName:
UPDATE SyncPeer SET name = ?, updatedAt = ? WHERE deviceId = ?;

deleteSyncPeer:
UPDATE SyncPeer SET isDeleted = 1, updatedAt = ? WHERE deviceId = ?;

-- Used when the device rotates its sync identity key: every pairing is
-- invalidated by the new key, so the local trust store is cleared.
deleteAllSyncPeers:
UPDATE SyncPeer SET isDeleted = 1, updatedAt = ? WHERE isDeleted = 0;

-- ==========================================
-- Sync Deltas (include tombstones: no isDeleted filter)
--
-- The delta cut is on the device-local sync sequence (syncSeq >= ?), which
-- is strictly monotone per device and re-stamped on every applied incoming
-- row, so the INCLUSIVE cut is exact: a row can never share a sequence with
-- the cursor and can never be stamped below a cursor that already passed it
-- (late arrivals from lagging peers always get a fresh sequence). Cursors
-- advance to maxSeq + 1, so nothing is ever skipped and nothing is ever
-- re-sent.
-- ==========================================

selectCharacterDeltas:
SELECT * FROM CharacterEntity WHERE syncSeq >= ?;

selectPersonaDeltas:
SELECT * FROM PersonaEntity WHERE syncSeq >= ?;

selectSessionDeltas:
SELECT * FROM ChatSession WHERE syncSeq >= ?;

selectMessageDeltas:
SELECT * FROM MessageEntity WHERE syncSeq >= ?;

selectApiConnectionDeltas:
SELECT * FROM ApiConnection WHERE syncSeq >= ?;

selectPromptBlockDeltas:
SELECT * FROM PromptBlockEntity WHERE syncSeq >= ?;

-- ==========================================
-- Sync upserts (full-row writes, LWW resolved in code)
-- ==========================================

selectCharacterByIdAny:
SELECT * FROM CharacterEntity WHERE id = ? LIMIT 1;

selectPersonaByIdAny:
SELECT * FROM PersonaEntity WHERE id = ? LIMIT 1;

selectSessionByIdAny:
SELECT * FROM ChatSession WHERE id = ? LIMIT 1;

selectMessageByIdAny:
SELECT * FROM MessageEntity WHERE id = ? LIMIT 1;

selectApiConnectionByIdAny:
SELECT * FROM ApiConnection WHERE id = ? LIMIT 1;

selectPromptBlockByIdAny:
SELECT * FROM PromptBlockEntity WHERE id = ? LIMIT 1;

upsertCharacterFull:
UPDATE CharacterEntity
SET name = ?, description = ?, personality = ?, scenario = ?, firstMes = ?,
    mesExample = ?, creatorNotes = ?, altGreetings = ?, avatarData = ?,
    isAssistant = ?, updatedAt = ?, isDeleted = ?, systemPrompt = ?,
    postHistoryInstructions = ?, creator = ?, characterVersion = ?, tags = ?,
    extensions = ?, characterBook = ?, syncSeq = ?
WHERE id = ?;

insertCharacterFull:
INSERT INTO CharacterEntity(id, name, description, personality, scenario, firstMes, mesExample, creatorNotes, altGreetings, avatarData, isAssistant, updatedAt, isDeleted, systemPrompt, postHistoryInstructions, creator, characterVersion, tags, extensions, characterBook, syncSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertPersonaFull:
UPDATE PersonaEntity
SET name = ?, description = ?, avatarData = ?, updatedAt = ?, isDeleted = ?, syncSeq = ?
WHERE id = ?;

insertPersonaFull:
INSERT INTO PersonaEntity(id, name, description, avatarData, updatedAt, isDeleted, syncSeq)
VALUES (?, ?, ?, ?, ?, ?, ?);

upsertSessionFull:
UPDATE ChatSession
SET characterId = ?, personaId = ?, title = ?, lastTimestamp = ?,
    currentMessageId = ?, parentSessionId = ?, updatedAt = ?, isDeleted = ?, syncSeq = ?
WHERE id = ?;

insertSessionFull:
INSERT INTO ChatSession(id, characterId, personaId, title, lastTimestamp, currentMessageId, parentSessionId, updatedAt, isDeleted, syncSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertMessageFull:
UPDATE MessageEntity
SET sessionId = ?, role = ?, content = ?, timestamp = ?, parentId = ?,
    isActivePath = ?, updatedAt = ?, isDeleted = ?, imageRefs = ?,
    reasoningText = ?, costEstimate = ?, syncSeq = ?
WHERE id = ?;

insertMessageFull:
INSERT INTO MessageEntity(id, sessionId, role, content, timestamp, parentId, isActivePath, updatedAt, isDeleted, imageRefs, reasoningText, costEstimate, syncSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertApiConnectionFull:
UPDATE ApiConnection
SET provider = ?, name = ?, baseUrl = ?, apiKey = ?, model = ?,
    inferenceProvider = ?, quantization = ?,
    isActive = ?, isChatCompletion = ?, lastUsed = ?, temperature = ?,
    topP = ?, topK = ?, presencePenalty = ?, frequencyPenalty = ?,
    contextLimit = ?, responseLimit = ?, displayOrder = ?, timeoutLimit = ?,
    reasoningOverride = ?, updatedAt = ?, isDeleted = ?, syncSeq = ?
WHERE id = ?;

insertApiConnectionFull:
INSERT INTO ApiConnection(
    id, provider, name, baseUrl, apiKey, model, inferenceProvider, quantization, isActive, isChatCompletion, lastUsed,
    temperature, topP, topK, presencePenalty, frequencyPenalty, contextLimit, responseLimit,
    displayOrder, timeoutLimit, reasoningOverride, updatedAt, isDeleted, syncSeq
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertPromptBlockFull:
UPDATE PromptBlockEntity
SET name = ?, template = ?, isEnabled = ?, isCustom = ?, displayOrder = ?,
    updatedAt = ?, isDeleted = ?, syncSeq = ?
WHERE id = ?;

insertPromptBlockFull:
INSERT INTO PromptBlockEntity(id, name, template, isEnabled, isCustom, displayOrder, updatedAt, isDeleted, syncSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);